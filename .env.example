NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://speaking:speaking@localhost:5432/speaking?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LIVEKIT_URL=ws://localhost:7880
# Optional browser-facing URL when the API reaches LiveKit through a private hostname.
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
MATCHMAKING_INTERVAL_MS=3000
MATCHMAKING_WIDEN_AFTER_SEC=120
READY_COUNTDOWN_SEC=5
ROUND_BREAK_SEC=20
RECONNECT_GRACE_SEC=45
DEFAULT_ROUND_DURATION_SEC=420
LOG_LEVEL=info
