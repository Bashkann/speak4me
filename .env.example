NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://speaking:speaking@localhost:5432/speaking?schema=public
# Comma-separated browser origins allowed by REST and Socket.IO CORS.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5180
JWT_ACCESS_SECRET=replace-with-at-least-32-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-characters-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
LIVEKIT_URL=ws://localhost:7880
# Optional browser-facing URL when the API reaches LiveKit through a private hostname.
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
MATCHMAKING_INTERVAL_MS=3000
MATCHMAKING_WIDEN_AFTER_SEC=120
READY_COUNTDOWN_SEC=5
ROUND_BREAK_SEC=20
RECONNECT_GRACE_SEC=45
DEFAULT_ROUND_DURATION_SEC=420
TOPIC_OFFER_CAP=3
# Optional direct-message image uploads. Leave false for text-only messaging.
IMAGE_UPLOADS_ENABLED=false
IMAGE_MAX_BYTES=5242880
# Required only when IMAGE_UPLOADS_ENABLED=true. S3_ENDPOINT is optional for AWS S3.
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=speak4me-messages
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_PUBLIC_BASE_URL=https://media.example.com
LOG_LEVEL=info
# Where OAuth/password-reset redirects point back to. Defaults to the first CORS_ORIGIN if unset.
# FRONTEND_URL=http://localhost:5173
# Optional Google sign-in. All three GOOGLE_* values are required together; see README "Optional Google sign-in".
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional password-reset email via Resend. Without these, reset links are logged instead of emailed.
# RESEND_API_KEY=replace-me
# RESEND_FROM_EMAIL=Speak Four <noreply@example.com>
