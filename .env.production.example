# Runtime mode — set by Railway for the backend service.
NODE_ENV=production
# HTTP listener port — Railway injects PORT; 3000 is suitable for Docker/VPS.
PORT=3000
# Host address exposed by production Compose — VPS only; keep loopback behind an HTTPS reverse proxy.
API_BIND_ADDRESS=127.0.0.1
# Backend env file path — production Compose uses this file; leave unchanged on the VPS.
BACKEND_ENV_FILE=.env.production
# PostgreSQL user — VPS production Compose only; Railway provides its own database variables.
POSTGRES_USER=speaking
# PostgreSQL password — generate a strong value for VPS production Compose.
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
# PostgreSQL database name — VPS production Compose only.
POSTGRES_DB=speaking
# PostgreSQL connection URL — use Railway's DATABASE_URL there; this value targets the VPS Compose service.
DATABASE_URL=postgresql://speaking:${POSTGRES_PASSWORD}@postgres:5432/speaking?schema=public
# Comma-separated HTTPS frontend origins — your Vercel/custom frontend domains.
CORS_ORIGIN=https://YOUR-PROJECT.vercel.app
# Access-token signing key (32+ random characters) — generate and set in Railway.
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Refresh-token signing key (32+ random characters, different from access) — generate and set in Railway.
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Access-token lifetime — application setting configured in Railway.
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime in days — application setting configured in Railway.
REFRESH_TOKEN_TTL_DAYS=30
# Secure WebSocket project URL — provided by LiveKit Cloud.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# Browser-facing LiveKit URL — normally the same LiveKit Cloud URL.
LIVEKIT_PUBLIC_URL=wss://YOUR-PROJECT.livekit.cloud
# Project API key — provided by LiveKit Cloud.
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
# Project API secret — provided by LiveKit Cloud.
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET
# Queue scan interval in milliseconds — application setting configured in Railway.
MATCHMAKING_INTERVAL_MS=3000
# Seconds before matchmaking widens the level range — application setting configured in Railway.
MATCHMAKING_WIDEN_AFTER_SEC=120
# Seconds before the first round starts — application setting configured in Railway.
READY_COUNTDOWN_SEC=5
# Seconds between speaking rounds — application setting configured in Railway.
ROUND_BREAK_SEC=20
# Seconds allowed for an active-room reconnect — application setting configured in Railway.
RECONNECT_GRACE_SEC=45
# Default speaking-round duration (300–600 seconds) — application setting configured in Railway.
DEFAULT_ROUND_DURATION_SEC=420
TOPIC_OFFER_CAP=3
# Optional image messages. Keep false unless all storage values below are configured.
IMAGE_UPLOADS_ENABLED=false
IMAGE_MAX_BYTES=5242880
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=speak4me-messages
# S3_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET
# S3_PUBLIC_BASE_URL=https://media.example.com
# Structured log verbosity — application setting configured in Railway.
LOG_LEVEL=info
# Deployed frontend origin — used for Google OAuth and password-reset redirect/email links.
FRONTEND_URL=https://YOUR-PROJECT.vercel.app
# Optional Google sign-in — from the Google Cloud console. All three are required together, or omit all three to hide the button.
# GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=https://YOUR-API-DOMAIN/api/auth/google/callback
# Optional password-reset email via Resend — https://resend.com. Without these, reset links are only logged.
# RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# RESEND_FROM_EMAIL=Speak Four <noreply@your-domain.com>
# Comma-separated emails auto-promoted to ADMIN the next time they log in with their own account. Preferred over the one-time seed below.
# ADMIN_EMAILS=you@example.com

# One-time production seed only: first administrator email — set temporarily in Railway.
SEED_ADMIN_EMAIL=admin@example.com
# One-time production seed only: strong 12+ character password — set temporarily, run the seed, then remove.
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD
# One-time production seed only: administrator display name — optional.
SEED_ADMIN_DISPLAY_NAME=Speak Four Admin
